APP_NAME=Ichimoku Multi-Market Auto Trader
ENVIRONMENT=paper
LIVE_TRADING_ENABLED=false
DATABASE_URL=sqlite+aiosqlite:///./trader.db
HOST=0.0.0.0
PORT=8000

# Strategy
ICHIMOKU_TENKAN=9
ICHIMOKU_KIJUN=26
ICHIMOKU_SENKOU_B=52

# Risk
MAX_DAILY_LOSS=1000
MAX_OPEN_POSITIONS=10
RISK_PER_TRADE=0.01
DEFAULT_STOP_LOSS_PCT=0.02
DEFAULT_TARGET_PCT=0.04
MAX_ORDER_VALUE=10000

# Broker settings — intentionally blank.
# Add these only to your server-side .env when you are ready.
NSE_BROKER=
NSE_API_KEY=
NSE_API_SECRET=
NASDAQ_BROKER=
NASDAQ_API_KEY=
NASDAQ_API_SECRET=

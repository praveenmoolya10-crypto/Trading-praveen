APP_NAME=Ichimoku Multi-Market Auto Trader
ENVIRONMENT=paper
LIVE_TRADING_ENABLED=false
DATABASE_URL=sqlite+aiosqlite:///./trader.db
HOST=0.0.0.0
PORT=8000

ICHIMOKU_TENKAN=9
ICHIMOKU_KIJUN=26
ICHIMOKU_SENKOU_B=52

MAX_DAILY_LOSS=1000
MAX_OPEN_POSITIONS=10
RISK_PER_TRADE=0.01
DEFAULT_STOP_LOSS_PCT=0.02
DEFAULT_TARGET_PCT=0.04
MAX_ORDER_VALUE=10000

# NSE / Zerodha Kite Connect
NSE_BROKER=kite
NSE_API_KEY=
NSE_ACCESS_TOKEN=

# US stocks / Alpaca
NASDAQ_BROKER=alpaca
NASDAQ_API_KEY=
NASDAQ_API_SECRET=
ALPACA_PAPER=true

# Keep false until you have completed paper testing and verified every control.
LIVE_TRADING_ENABLED=false
